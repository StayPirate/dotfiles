{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.8-flash",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "model": "google/gemini-3.8-flash",
      "variant": "high"
    },
    "build": {
      "model": "google/gemini-3.8-flash",
      "variant": "high"
    }
  },
  "mcp": {
    "comfyui": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": ["/usr/bin/uvx", "mcp-for-blender"],
      "enabled": true,
      "environment": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true",
        "TMPDIR": "/home/crazybyte/.var/app/org.blender.Blender/cache/tmp"
      }
    }
  },
  "plugin": [
    "opencode-gemini-auth@latest",
    "/home/crazybyte/Workspace/opencode_plugin"
  ],
  "provider": {
    "helmcode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Helmcode",
      "options": {
        "baseURL": "https://api.helmcode.com/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4.1 Flash",
          "cost": {
            "input": 0.3,
            "output": 1.2,
            "cache_read": 0.006,
            "cache_write": 0
          },
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "low": {
              "reasoningEffort": "low"
            },
            "none": {
              "reasoningEffort": "none"
            }
